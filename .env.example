# =============================================================================
# Whole Life Journey - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
#
# LOCAL DEVELOPMENT: Only SECRET_KEY, DEBUG, and ALLOWED_HOSTS are required
# PRODUCTION (Railway): Set all variables in Railway's environment settings
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED - Django Core Settings
# -----------------------------------------------------------------------------

# Generate a new secret key for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=dev-secret-key-change-in-production-use-long-random-string

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts
# Local: localhost,127.0.0.1
# Production: your-app.railway.app,wholelifejourney.com
ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# DATABASE - Automatic in Railway
# -----------------------------------------------------------------------------

# Railway provides DATABASE_URL automatically when you add PostgreSQL
# Leave blank/commented for local development to use SQLite
# DATABASE_URL=postgres://user:password@host:5432/dbname

# -----------------------------------------------------------------------------
# AI FEATURES (OpenAI)
# -----------------------------------------------------------------------------

# Required for AI coaching insights on dashboard
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# EMAIL (Resend) - Production Only
# -----------------------------------------------------------------------------

# Get your API key at: https://resend.com
# Not needed for local dev - emails print to console
# RESEND_API_KEY=re_your_api_key_here
DEFAULT_FROM_EMAIL=noreply@wholelifejourney.com

# -----------------------------------------------------------------------------
# SECURITY - Production Only
# -----------------------------------------------------------------------------

# Must be False for local development (no HTTPS)
SECURE_SSL_REDIRECT=False

# Required in production for CSRF protection
# CSRF_TRUSTED_ORIGINS=https://your-app.railway.app,https://wholelifejourney.com

# -----------------------------------------------------------------------------
# GOOGLE CALENDAR INTEGRATION (Optional)
# -----------------------------------------------------------------------------

# Get credentials at: https://console.cloud.google.com/apis/credentials
# GOOGLE_CALENDAR_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CALENDAR_CLIENT_SECRET=your-client-secret

# Production redirect URI (optional - defaults to https://wholelifejourney.com/life/calendar/google/callback/)
# Make sure this exact URL is added to Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client > Authorized redirect URIs
# GOOGLE_CALENDAR_REDIRECT_URI=https://wholelifejourney.com/life/calendar/google/callback/

# -----------------------------------------------------------------------------
# YOUVERSION BIBLE API (Optional - for Faith module Scripture lookups)
# -----------------------------------------------------------------------------

# Get your API key at: https://platform.youversion.com/
# Without this key, Bible translation selection will show "API not configured"
# YOUVERSION_API_KEY=your-api-key-here

# -----------------------------------------------------------------------------
# PLAID BANK INTEGRATION (Optional - for Finance module bank connectivity)
# -----------------------------------------------------------------------------

# Get your credentials at: https://dashboard.plaid.com/overview
# PLAID_CLIENT_ID=your_client_id
# PLAID_SECRET=your_secret_key
# PLAID_ENV=sandbox  # sandbox, development, or production

# Token encryption key - generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BANK_TOKEN_ENCRYPTION_KEY=your-32-byte-base64-fernet-key

# Webhook URL for real-time transaction updates (production only)
# PLAID_WEBHOOK_URL=https://wholelifejourney.com/finance/webhooks/plaid/

# OAuth redirect URI for OAuth-enabled banks (production only)
# PLAID_REDIRECT_URI=https://wholelifejourney.com/finance/plaid/oauth/

# -----------------------------------------------------------------------------
# CLAUDE CODE API KEY (Development - for task management)
# -----------------------------------------------------------------------------

# API key for Claude Code to access the WLJ task management API
# This is used by slash commands (/next, /run-task) to fetch and update tasks
# Get the key from your Django admin at /admin-console/settings/
WLJ_CLAUDE_API_KEY=

# -----------------------------------------------------------------------------
# SENTRY ERROR TRACKING (Production - Recommended)
# -----------------------------------------------------------------------------

# Get your DSN at: https://sentry.io/ (free tier available)
# Sentry provides real-time error tracking, performance monitoring, and alerting
# SENTRY_DSN=https://xxxx@xxxxx.ingest.sentry.io/xxxxx

# Performance monitoring sample rate (0.0-1.0, default 0.1 = 10%)
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Profiling sample rate for detailed performance insights (default 0.1)
# SENTRY_PROFILES_SAMPLE_RATE=0.1

# Environment tag (production, staging, development)
# SENTRY_ENVIRONMENT=production
